---
interface Props { image: string; title: string; tagline: string; }
const { image, title, tagline } = Astro.props;
---
<section class="service-hero" style={`--hero-image: url('${image}')`}>
  <div class="shade"></div>
  <div class="content"><p>{tagline}</p><h1>{title}</h1></div>
</section>
<style>
  .service-hero{position:relative;display:grid;min-height:clamp(29rem,57vw,47rem);align-items:end;overflow:hidden;background-image:var(--hero-image);background-position:center;background-size:cover;color:#fff}
  .shade{position:absolute;inset:0;background:linear-gradient(180deg,rgb(0 0 0/8%) 20%,rgb(0 0 0/65%) 100%)}
  .content{position:relative;z-index:1;width:min(82rem,100%);margin:0 auto;padding:clamp(3rem,8vw,7rem) clamp(1.5rem,5vw,4rem)}
  p{max-width:48rem;margin:0 0 1.25rem;font-family:Georgia,"Times New Roman",serif;font-size:clamp(1.25rem,2.5vw,2rem);font-style:italic;line-height:1.45}
  h1{margin:0;font-size:clamp(2.5rem,6vw,5.5rem);font-weight:650;letter-spacing:.08em;line-height:.95;text-transform:uppercase}
</style>
