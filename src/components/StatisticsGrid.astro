---
const statistics = [
  { label: 'Established', image: '/assets/about/statistics/established.webp', alt: 'Century established in 1971' },
  { label: 'Properties & Counting', image: '/assets/about/statistics/properties.webp', alt: '130 or more properties and counting' },
  { label: 'Residential Units', image: '/assets/about/statistics/residential-units.webp', alt: '15,000 or more residential units' },
  { label: 'New Mortgages Originated', image: '/assets/about/statistics/mortgages.webp', alt: '160 in new mortgages originated' },
  { label: 'Raised for Children’s Charity', image: '/assets/about/statistics/charity.webp', alt: 'More than 6 million dollars raised for children’s charity' },
  { label: 'Support & Commitment', image: '/assets/about/statistics/support.webp', alt: '24 hours a day, 7 days a week support and commitment' },
] as const;
---

<section class="statistics" aria-labelledby="statistics-heading">
  <div class="inner">
    <h2 id="statistics-heading">Century at a Glance</h2>
    <div class="grid">
      {statistics.map((statistic) => (
        <article>
          <img src={statistic.image} alt={statistic.alt} width="300" height="200" loading="lazy" />
          <h3>{statistic.label}</h3>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .statistics { padding: clamp(4.5rem, 8vw, 7rem) 0; background: #f9f9f9; color: #111; }
  .inner { width: min(78rem, 100%); margin: 0 auto; padding: 0 clamp(1.5rem, 5vw, 4rem); }
  h2 { margin: 0 0 clamp(3.5rem, 6vw, 5rem); font-family: Hind, Arial, sans-serif; font-size: 1.75rem; font-weight: 300; letter-spacing: .08em; text-align: center; text-transform: uppercase; }
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(3.5rem, 6vw, 5rem) clamp(2rem, 5vw, 4rem); }
  article { text-align: center; }
  img { display: block; width: min(100%, 300px); height: auto; margin-inline: auto; object-fit: contain; }
  h3 { margin: 1.25rem 0 0; font-family: Hind, Arial, sans-serif; font-size: clamp(1.15rem, 2vw, 1.5rem); font-weight: 300; letter-spacing: .04em; line-height: 1.35; }
  @media (max-width: 700px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 430px) { .grid { grid-template-columns: 1fr; } }
</style>
