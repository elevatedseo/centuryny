---
const statistics = ['Established','Properties & Counting','Residential Units','New Mortgages Originated','Raised for Children’s Charity','Support & Commitment'];
---
<section class="statistics" aria-labelledby="statistics-heading">
  <div class="inner"><p class="eyebrow">Century at a Glance</p><h2 id="statistics-heading">Century at a Glance</h2><div class="grid">{statistics.map((label) => <article><strong aria-label={`${label} value pending verification`}>—</strong><h3>{label}</h3><p>Value pending verification</p></article>)}</div></div>
</section>
<style>
  .statistics{padding:clamp(4rem,9vw,8rem) 0;background:#242426;color:#fff}.inner{width:min(78rem,100%);margin:0 auto;padding:0 clamp(1.5rem,5vw,4rem)}.eyebrow{margin:0 0 .8rem;color:#d12240;font-size:.72rem;font-weight:750;letter-spacing:.16em;text-transform:uppercase}h2{margin:0 0 clamp(2.5rem,5vw,4rem);font-family:Georgia,"Times New Roman",serif;font-size:clamp(2.2rem,4vw,3.8rem);font-weight:400}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border-top:1px solid #444448;border-left:1px solid #444448}article{min-height:12rem;padding:2.25rem;border-right:1px solid #444448;border-bottom:1px solid #444448}strong{display:block;color:#d12240;font-family:Georgia,"Times New Roman",serif;font-size:3rem;font-weight:400}h3{margin:1rem 0 .5rem;font-size:.76rem;letter-spacing:.1em;text-transform:uppercase}article p{margin:0;color:#88888c;font-size:.68rem;letter-spacing:.08em;text-transform:uppercase}@media(max-width:700px){.grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:430px){.grid{grid-template-columns:1fr}}
</style>
