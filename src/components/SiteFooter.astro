---
const centuryLinks = [
  { label: 'About', href: '/about-us/' },
  { label: 'Services', href: '/our-services/property-management/' },
  { label: 'Featured Properties', href: '/featured-properties/' },
  { label: 'Boardmembers Portal', href: 'https://centuryny.smartvault.com', external: true },
  { label: 'Find It on Domecile', href: 'https://century.domecile.com/buildings', external: true },
  { label: 'Bilt', href: 'https://www.paywithbilt.com/century', external: true },
];

const serviceLinks = [
  { label: 'Property Management', href: '/our-services/property-management/' },
  { label: 'Financial Management', href: '/our-services/financial-management/' },
  { label: 'Project Management', href: '/our-services/project-management/' },
];
---

<aside class="contact-cta" aria-labelledby="contact-heading">
  <div>
    <h2 id="contact-heading">We’d love to hear from you.</h2>
    <p>Request a quote to find out how we can help.</p>
  </div>
  <a href="/contact-us/">Contact us</a>
</aside>

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <a href="/" aria-label="Century Management home">
        <img src="/assets/century-logo-light.png" alt="Century Management" width="429" height="77" />
      </a>
      <p>New York’s leading property management company.</p>
    </div>

    <nav aria-labelledby="century-links-heading">
      <h2 id="century-links-heading">Century</h2>
      <ul>
        {centuryLinks.map((item) => (
          <li>
            <a
              href={item.href}
              target={item.external ? '_blank' : undefined}
              rel={item.external ? 'noopener noreferrer' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <nav aria-labelledby="services-links-heading">
      <h2 id="services-links-heading">Our Services</h2>
      <ul>
        {serviceLinks.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <div class="office">
      <h2>Our Office</h2>
      <address>
        1430 Broadway<br />
        Suite 505<br />
        New York, NY 10018
      </address>
      <p>
        Phone: <a href="tel:+12125606400">212. 560. 6400</a><br />
        Facsimile: 212. 560. 6420
      </p>
    </div>
  </div>
  <div class="footer-bottom">
    <p>© {new Date().getFullYear()} Century Management. All rights reserved.</p>
  </div>
</footer>

<style>
  .contact-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: clamp(2.5rem, 6vw, 5rem) clamp(1.5rem, 8vw, 8rem);
    background: #d12240;
    color: #fff;
  }

  .contact-cta h2 {
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 400;
    letter-spacing: -0.025em;
  }

  .contact-cta p {
    margin: 0.65rem 0 0;
    font-size: clamp(1rem, 1.5vw, 1.2rem);
  }

  .contact-cta > a {
    flex: 0 0 auto;
    padding: 0.95rem 1.65rem;
    border: 1px solid #fff;
    font-size: 0.76rem;
    font-weight: 750;
    letter-spacing: 0.13em;
    text-decoration: none;
    text-transform: uppercase;
    transition: background 150ms ease, color 150ms ease;
  }

  .contact-cta > a:hover,
  .contact-cta > a:focus-visible {
    background: #fff;
    color: #d12240;
  }

  .site-footer {
    background: #242426;
    color: #d4d4d4;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: minmax(13rem, 1.45fr) repeat(3, minmax(10rem, 1fr));
    gap: clamp(2.5rem, 5vw, 5rem);
    padding: clamp(3.5rem, 7vw, 6rem) clamp(1.5rem, 8vw, 8rem);
  }

  .footer-brand img {
    width: min(100%, 15rem);
    height: auto;
  }

  .footer-brand p {
    max-width: 20rem;
    margin: 1.35rem 0 0;
    color: #9d9d9f;
    line-height: 1.7;
  }

  .site-footer h2 {
    margin: 0 0 1.35rem;
    color: #fff;
    font-size: 0.78rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .site-footer ul {
    display: grid;
    gap: 0.7rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer li,
  .site-footer address,
  .office p {
    color: #a9a9ab;
    font-size: 0.76rem;
    font-style: normal;
    letter-spacing: 0.04em;
    line-height: 1.85;
    text-transform: uppercase;
  }

  .site-footer a {
    text-decoration: none;
  }

  .site-footer nav a:hover,
  .site-footer nav a:focus-visible,
  .office a:hover,
  .office a:focus-visible {
    color: #fff;
  }

  .office p {
    margin: 1rem 0 0;
  }

  .footer-bottom {
    padding: 1.3rem clamp(1.5rem, 8vw, 8rem);
    border-top: 1px solid #39393b;
  }

  .footer-bottom p {
    margin: 0;
    color: #77777a;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (max-width: 900px) {
    .footer-inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .contact-cta {
      align-items: flex-start;
      flex-direction: column;
    }

    .footer-inner {
      grid-template-columns: 1fr;
    }
  }
</style>
