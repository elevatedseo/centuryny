---
const services = [
  { label: 'Property Management', href: '/our-services/property-management/' },
  { label: 'Project Management', href: '/our-services/project-management/' },
  { label: 'Financial Management', href: '/our-services/financial-management/' },
];

const links = [
  { label: 'About', href: '/about-us/' },
  { label: 'Featured Properties', href: '/featured-properties/' },
  {
    label: 'Boardmembers Portal',
    href: 'https://centuryny.smartvault.com',
    external: true,
  },
  {
    label: 'Find It on Domecile',
    href: 'https://century.domecile.com/buildings',
    external: true,
  },
  {
    label: 'Bilt – Resident Payments',
    href: 'https://www.paywithbilt.com/century',
    external: true,
  },
];
---

<header class="site-header">
  <a class="wordmark" href="/" aria-label="Century Management home">
    <img src="/assets/century-logo-header.png" alt="Century Management" width="429" height="77" />
  </a>

  <nav class="desktop-nav" aria-label="Primary navigation">
    <a href={links[0].href}>{links[0].label}</a>
    <div class="services-menu">
      <a href={services[0].href} aria-haspopup="true">Services</a>
      <div class="submenu">
        {services.map((item) => <a href={item.href}>{item.label}</a>)}
      </div>
    </div>
    {links.slice(1).map((item) => (
      <a
        href={item.href}
        target={item.external ? '_blank' : undefined}
        rel={item.external ? 'noopener noreferrer' : undefined}
      >
        {item.label}
      </a>
    ))}
  </nav>

  <details class="mobile-nav">
    <summary aria-label="Open navigation"><span>Menu</span></summary>
    <nav aria-label="Mobile navigation">
      <a href={links[0].href}>{links[0].label}</a>
      <details>
        <summary>Services</summary>
        <div class="mobile-submenu">
          {services.map((item) => <a href={item.href}>{item.label}</a>)}
        </div>
      </details>
      {links.slice(1).map((item) => (
        <a
          href={item.href}
          target={item.external ? '_blank' : undefined}
          rel={item.external ? 'noopener noreferrer' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </details>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 10;
    display: flex;
    min-height: 5rem;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 0.9rem clamp(1.25rem, 4vw, 4rem);
    border-bottom: 1px solid #d9d5cc;
    background: #242426;
    color: #fff;
  }

  .wordmark {
    display: block;
    flex: 0 0 auto;
    text-decoration: none;
  }

  .wordmark img {
    display: block;
    width: clamp(11rem, 16vw, 14rem);
    height: auto;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: clamp(0.8rem, 1.7vw, 1.8rem);
  }

  .desktop-nav a {
    padding: 1.25rem 0;
    font-size: clamp(0.57rem, 0.72vw, 0.72rem);
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.25;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
  }

  .desktop-nav > a:hover,
  .desktop-nav > a:focus-visible,
  .services-menu > a:hover,
  .services-menu > a:focus-visible {
    color: #8a6a2f;
  }

  .services-menu {
    position: relative;
  }

  .submenu {
    position: absolute;
    top: calc(100% - 0.5rem);
    left: 50%;
    display: grid;
    width: max-content;
    min-width: 15rem;
    padding: 0.55rem 1rem;
    background: #171714;
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, 0.5rem);
    transition: opacity 150ms ease, transform 150ms ease;
  }

  .submenu a {
    padding: 0.75rem;
    color: #fff;
    text-align: left;
  }

  .submenu a:hover,
  .submenu a:focus-visible {
    color: #d9c08a;
  }

  .services-menu:hover .submenu,
  .services-menu:focus-within .submenu {
    opacity: 1;
    pointer-events: auto;
    transform: translate(-50%, 0);
  }

  .mobile-nav {
    display: none;
  }

  @media (max-width: 1050px) {
    .desktop-nav {
      display: none;
    }

    .mobile-nav {
      display: block;
    }

    .mobile-nav > summary {
      cursor: pointer;
      font-size: 0.72rem;
      font-weight: 750;
      letter-spacing: 0.15em;
      list-style: none;
      text-transform: uppercase;
    }

    .mobile-nav > summary::-webkit-details-marker {
      display: none;
    }

    .mobile-nav > nav {
      position: absolute;
      top: 100%;
      right: 0;
      left: 0;
      display: grid;
      padding: 0.8rem clamp(1.25rem, 4vw, 4rem) 1.25rem;
      border-top: 1px solid #e5e2da;
      background: #242426;
      box-shadow: 0 1rem 2rem rgb(0 0 0 / 10%);
    }

    .mobile-nav nav a,
    .mobile-nav nav summary {
      display: block;
      padding: 0.75rem 0;
      cursor: pointer;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      list-style: none;
      text-decoration: none;
      text-transform: uppercase;
    }

    .mobile-nav nav summary::-webkit-details-marker {
      display: none;
    }

    .mobile-nav nav summary::after {
      float: right;
      content: '+';
    }

    .mobile-nav nav details[open] summary::after {
      content: '−';
    }

    .mobile-submenu {
      display: grid;
      padding-left: 1rem;
      border-left: 1px solid #d9d5cc;
    }
  }
</style>
