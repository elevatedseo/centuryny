---
interface Props {
  eyebrow?: string;
  title: string;
}

const { eyebrow = 'Century Management', title } = Astro.props;
---

<main class="page-intro">
  <p>{eyebrow}</p>
  <h1>{title}</h1>
</main>

<style>
  .page-intro {
    display: grid;
    min-height: calc(100vh - 5rem);
    min-height: calc(100svh - 5rem);
    align-content: center;
    padding: clamp(3rem, 9vw, 9rem) clamp(1.5rem, 8vw, 8rem);
  }

  p {
    margin: 0 0 1rem;
    color: #6c675e;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 12ch;
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(3rem, 9vw, 8rem);
    font-weight: 400;
    letter-spacing: -0.055em;
    line-height: 0.95;
  }
</style>
