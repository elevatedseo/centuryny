---
import BaseLayout from '../layouts/BaseLayout.astro';

const contacts = [
  { department: 'Management', email: 'jsirotkin@centuryny.com' },
  { department: 'Transfer Department', email: 'transfer@centuryny.com' },
  { department: 'Accounts Receivable', email: 'accountsreceivable@centuryny.com' },
  { department: 'AJ Rexhepi – CEO', email: 'arexhepi@centuryny.com' },
] as const;
---

<BaseLayout
  title="Property Management Company - Contact Us | Century NY"
  description="We’d love to hear from you. Please get in touch with our property management experts at Century Management NY."
>
  <main>
    <section class="contact-hero" aria-labelledby="contact-title">
      <div class="hero-copy">
        <h1 id="contact-title">Contact</h1>
        <p>We’d love to hear from you.</p>
      </div>
    </section>
    <section class="contact-intro" aria-label="Contact introduction">
      <p>Please use the information below to contact a representative today.</p>
    </section>
    <section class="contact-details">
      <div class="details-column">
        <h2>Contact Information</h2>
        <span class="rule" aria-hidden="true"></span>
        <div class="contact-list">
          {contacts.map((contact) => (
            <div class="contact-record">
              <h3>{contact.department}</h3>
              <a href={`mailto:${contact.email}`}>{contact.email}</a>
            </div>
          ))}
        </div>
      </div>
      <div class="details-column office">
        <h2>Our Office</h2>
        <span class="rule" aria-hidden="true"></span>
        <address>1430 Broadway<br />Suite 505<br />New York, NY 10504</address>
        <p>Phone: <a href="tel:+12125606400">212 560 6400</a><br />Facsimile: 212 560 6420</p>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .contact-hero { display: grid; min-height: min(750px, calc(100svh - 5rem)); align-items: center; background: linear-gradient(90deg, rgb(0 0 0 / 28%), rgb(0 0 0 / 5%)), url('/assets/contact/Header-contact.webp') center / cover no-repeat; color: #fff; }
  .hero-copy { width: min(1180px, 80%); margin-inline: auto; }
  .hero-copy h1 { margin: 0 0 1.1rem; font-family: Hind, Arial, sans-serif; font-size: clamp(3.4rem, 6vw, 3.75rem); font-weight: 300; letter-spacing: .035em; line-height: 1; text-transform: uppercase; }
  .hero-copy p { margin: 0; font-family: Hind, Arial, sans-serif; font-size: clamp(1.15rem, 2vw, 1.5rem); font-weight: 600; letter-spacing: .04em; line-height: 1.45; }
  .contact-intro { display: grid; min-height: 15rem; place-items: center; padding: 3rem 1.5rem; background: #f9f9f9; text-align: center; }
  .contact-intro p { max-width: 47rem; margin: 0; color: #171714; font-family: Hind, Arial, sans-serif; font-size: clamp(1.2rem, 2vw, 1.5rem); font-weight: 600; letter-spacing: .075em; line-height: 1.35; }
  .contact-details { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(4rem, 13vw, 11rem); width: min(980px, calc(100% - 3rem)); margin-inline: auto; padding-block: clamp(5rem, 8vw, 7.5rem); }
  .details-column h2 { margin: 0; color: #111; font-family: Hind, Arial, sans-serif; font-size: 1.5rem; font-weight: 300; letter-spacing: .08em; line-height: 1; }
  .rule { display: block; width: 6.25rem; margin: 1.25rem 0 2.5rem; border-top: 1px solid #d12240; }
  .contact-list { display: grid; gap: 1.75rem; }
  .contact-record h3 { margin: 0 0 .4rem; color: #111; font-family: Hind, Arial, sans-serif; font-size: .94rem; font-weight: 600; letter-spacing: .12em; line-height: 1.25; text-transform: uppercase; }
  .contact-record a, .office, .office a { color: #68717b; font-family: Hind, Arial, sans-serif; font-size: .96rem; line-height: 1.8; }
  .contact-record a, .office a { text-decoration-color: #c5c8cb; text-underline-offset: .22em; }
  .contact-record a:hover, .contact-record a:focus-visible, .office a:hover, .office a:focus-visible { color: #d12240; }
  .office address { font-style: normal; }
  .office p { margin: 1.35rem 0 0; }
  @media (max-width: 700px) {
    .contact-hero { min-height: 30rem; background-position: 62% center; }
    .hero-copy { width: calc(100% - 3rem); }
    .contact-intro { min-height: 13rem; }
    .contact-details { grid-template-columns: 1fr; gap: 4rem; }
  }
</style>
