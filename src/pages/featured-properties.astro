---
import BaseLayout from '../layouts/BaseLayout.astro';
import PropertyGrid from '../components/PropertyGrid.astro';
---

<BaseLayout
  title="NY Property Management Company - Featured Properties | Century NY"
  description="Century Management is a premier property management company serving the New York area. View our featured properties or contact us to learn more."
>
  <main>
    <header class="page-heading">
      <p>Our Portfolio</p>
      <h1>Featured Properties</h1>
      <div class="rule"></div>
      <p class="intro">We manage a diverse portfolio, offering scalable services for buildings of all sizes—including rental, co-op, and condo properties—totaling nearly 20,000 units and over 150 properties across the New York Metropolitan area.</p>
    </header>
    <PropertyGrid />
  </main>
</BaseLayout>

<style>
  .page-heading{display:grid;justify-items:center;padding:clamp(5rem,10vw,9rem) clamp(1.5rem,6vw,6rem);background:#fff;text-align:center}.page-heading>p:first-child{margin:0 0 .75rem;color:#d12240;font-size:.72rem;font-weight:750;letter-spacing:.17em;text-transform:uppercase}h1{margin:0;font-family:Georgia,"Times New Roman",serif;font-size:clamp(3rem,7vw,6.5rem);font-weight:400;letter-spacing:-.05em;line-height:1}.rule{width:3.5rem;height:2px;margin:2rem 0;background:#d12240}.intro{max-width:62rem;margin:0;color:#626058;font-family:Georgia,"Times New Roman",serif;font-size:clamp(1.15rem,2vw,1.55rem);line-height:1.7}
</style>
