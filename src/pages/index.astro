---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeSlider from '../components/HomeSlider.astro';
import HomepageSections from '../components/HomepageSections.astro';

const title = 'Century Management - A New York Property Management Company';
const description = 'Founded in 1971, Century Management is a leading full-service property management company in New York. We specialize in managing rentals, co-ops, condos and more.';
---

<BaseLayout {title} {description}>
  <main>
    <HomeSlider />
    <HomepageSections />
  </main>
</BaseLayout>
